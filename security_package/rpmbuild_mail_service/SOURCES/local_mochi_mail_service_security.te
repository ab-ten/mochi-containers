module local_mochi_mail_service_security 1.0;

require {
    type systemd_socket_proxyd_t;
    type smtp_port_t;
    type pop_port_t;
    attribute port_type;
    class tcp_socket name_bind;
    class tcp_socket name_connect;
}

type mochi_mail_high_port_t, port_type;

# ホスト側の SMTP、POP3、Submission ポートを待ち受けます。
allow systemd_socket_proxyd_t smtp_port_t:tcp_socket name_bind;
allow systemd_socket_proxyd_t pop_port_t:tcp_socket name_bind;

# rootless Podman が公開する mail_service の high port へ転送します。
allow systemd_socket_proxyd_t mochi_mail_high_port_t:tcp_socket name_connect;
